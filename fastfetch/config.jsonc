// ─────────────────────────────────────────────────────────────────────────────
//  fastfetch config — Neofetch-Ai
//
//  Установка:
//      mkdir -p ~/.config/fastfetch
//      cp fastfetch/config.jsonc ~/.config/fastfetch/config.jsonc
//
//  Проверить без установки:
//      fastfetch --config fastfetch/config.jsonc
//
//  Все опции: https://github.com/fastfetch-cli/fastfetch/wiki/Configuration
//  Список модулей: fastfetch --list-modules
// ─────────────────────────────────────────────────────────────────────────────

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Логотип: встроенный Arch.
    //   "auto"                                    — угадать по дистрибутиву
    //   null                                      — без логотипа
    //   { "type": "file", "source": "~/art.txt" } — свой ASCII-арт из файла
    "logo": {
        "type": "builtin",
        "source": "arch",
        "padding": {
            "top": 0,
            "right": 2
        }
    },

    "display": {
        "separator": ": ",
        "color": {
            "keys": "cyan",     // цвет подписей: OS, Kernel, CPU ...
            "title": "cyan",    // цвет user@host
            "output": "default" // цвет значений
        },
        "stat": true,           // печатать время сбора (аналог --stat)
        "showErrors": false,
        "pipe": false
    },

    // Параллельный сбор (general.thread / general.multithreading) в fastfetch
    // включён по умолчанию — явно задавать не нужно.

    // Поля и их порядок. Строка — имя модуля, объект — модуль с настройками.
    "modules": [
        // Цвет заголовка задаётся в display.color.title; при желании можно
        // перекрасить части отдельно: { "type": "title", "color": {...} }
        "title",
        { "type": "separator", "string": "-", "times": 0 }, // подчёркивание под заголовком

        { "type": "os", "key": "OS" },
        { "type": "host", "key": "Host" },
        { "type": "kernel", "key": "Kernel" },
        { "type": "uptime", "key": "Uptime" },
        { "type": "packages", "key": "Packages" },
        { "type": "shell", "key": "Shell" },
        { "type": "display", "key": "Resolution" },
        { "type": "de", "key": "DE" },
        { "type": "wm", "key": "WM" },
        { "type": "wmtheme", "key": "WM Theme" },
        { "type": "theme", "key": "Theme" },
        { "type": "icons", "key": "Icons" },
        { "type": "font", "key": "Font" },
        { "type": "terminal", "key": "Terminal" },
        { "type": "terminalfont", "key": "Terminal Font" },
        { "type": "cpu", "key": "CPU", "temp": true },
        { "type": "gpu", "key": "GPU" },
        // percent: 1 — только число, 2 — только полоска, 3 — число и полоска
        { "type": "memory", "key": "Memory", "percent": { "type": 1 } },
        { "type": "swap", "key": "Swap" },
        { "type": "disk", "key": "Disk" },
        { "type": "battery", "key": "Battery" },
        { "type": "locale", "key": "Locale" },
        { "type": "localip", "key": "Local IP" },

        { "type": "colors", "key": " ", "paddingLeft": 0, "symbol": "block" }
    ]
}
